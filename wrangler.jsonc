{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coldbrew",
  "account_id": "f7df7fafe5b4e9d4e0446100575c0bf4",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "coldbrew.lil.run",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coldbrew",
      "database_id": "2aac40ec-579b-4682-8f1f-ad49a4b12df8"
    }
  ],
  "triggers": {
    "crons": ["0 10 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
